Нижче наведено фрагмент розробленого модуля `tab_lab3.py`, що реалізує алгоритми генерації, нелінійного перетворення, МГК та побудови лінійного різноманіття:

```python
import numpy as np
import pandas as pd
from scipy import stats

def generate_data(params: dict, seed: int = 42) -> pd.DataFrame:
    """Генерація вибірки за параметрами Варіанта 6."""
    np.random.seed(seed)
    N, sigma, snoise = params['N'], params['sigma'], params['sigma_noise']
    phi, mu = params['phi'], params['mu']
    t1, t2 = np.deg2rad(params['theta1_deg']), np.deg2rad(params['theta2_deg'])

    xi1 = np.random.normal(0, sigma, N)
    xi2 = np.random.normal(0, sigma, N)
    xi3 = np.random.normal(0, snoise, N)
    Xi = np.column_stack([xi1, xi2, xi3])

    Rz = np.array([[np.cos(t1), -np.sin(t1), 0],
                   [np.sin(t1),  np.cos(t1), 0],
                   [0, 0, 1]])
    Ry = np.array([[ np.cos(t2), 0, np.sin(t2)],
                   [0, 1, 0],
                   [-np.sin(t2), 0, np.cos(t2)]])

    X = (Ry @ Rz @ Xi.T).T + mu
    X3_norm = (X[:, 2] - X[:, 2].mean()) / X[:, 2].std()
    X[:, 2] = np.exp(phi * X3_norm)
    return pd.DataFrame(X, columns=['x1', 'x2', 'x3'])

def apply_log_transform(df: pd.DataFrame):
    """Нелінійне логарифмічне перетворення для ознак з асиметрією."""
    df2 = df.copy()
    transformed = {}
    for col in df.columns:
        if abs(stats.skew(df[col])) > 0.5 and df[col].min() > 0:
            df2[col] = np.log(df[col])
            transformed[col] = stats.skew(df[col])
    return df2, transformed

def run_pca(df: pd.DataFrame) -> dict:
    """МГК на основі кореляційної матриці."""
    X = df.values.astype(float)
    X_mean = X.mean(axis=0)
    X_std = X.std(axis=0, ddof=1)
    X_z = (X - X_mean) / X_std

    R = np.corrcoef(X_z.T)
    evals, evecs = np.linalg.eigh(R)
    idx = np.argsort(evals)[::-1]
    evals, evecs = evals[idx], evecs[:, idx]

    for j in range(X.shape[1]):
        if evecs[np.argmax(np.abs(evecs[:, j])), j] < 0:
            evecs[:, j] *= -1.0

    var_pct = evals / evals.sum() * 100.0
    cum_pct = np.cumsum(var_pct)
    Z = X_z @ evecs
    return {'evals': evals, 'evecs': evecs, 'var_pct': var_pct,
            'cum_pct': cum_pct, 'Z': Z, 'X_z': X_z, 'X_mean': X_mean, 'X_std': X_std}

def build_manifold(res: dict, m: int = 2) -> dict:
    """Побудова очищеного різноманіття та рівняння площини."""
    Z_m, V_m = res['Z'][:, :m], res['evecs'][:, :m]
    X_clean_z = Z_m @ V_m.T
    n_std = res['evecs'][:, m]  # нормаль до площини (третій власний вектор)

    A_coef = n_std / res['X_std']
    D_coef = -np.dot(A_coef, res['X_mean'])
    rmse = float(np.sqrt(np.mean((X_clean_z @ n_std)**2)))
    return {'X_clean_z': X_clean_z, 'n_std': n_std,
            'A_coef': A_coef, 'D_coef': D_coef, 'rmse_manifold': rmse}
